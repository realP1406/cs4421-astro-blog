# Copy this file to .env and fill in the values from Supabase (Project Settings -> API).
# Use the PUBLISHABLE key (starts with sb_publishable_), never the secret/service_role key.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional, used by docker compose
# APP_VERSION=dev
# GIT_SHA=local
# LOG_LEVEL=INFO
